<?xml version="1.0" encoding="UTF-8"?>
<!--
  BloodBuddy backend — Spring MVC + Hibernate/JPA + MySQL (CPJ119 §2.2, §2.3, §2.4, §2.5, §2.6).

  Open this folder in IntelliJ (File → Open → select backend/) — IntelliJ's bundled
  Maven imports it automatically. No Maven CLI install required.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.bloodbuddy</groupId>
  <artifactId>bloodbuddy-backend</artifactId>
  <version>1.0.0</version>
  <name>BloodBuddy Backend</name>
  <description>Spring MVC backend for the BloodBuddy blood donor management system (CPP401)</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- §2.2 Spring MVC: REST controllers + serving the static frontend -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- §2.3 Hibernate ORM + JPA, MySQL persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Bean Validation: server-side validation (CPJ119 §4 — validation on BOTH tiers) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- §2.4 SMTP email (registration confirmation). Dev mail goes to MailHog. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- §2.5 image handling: Base64 photos stored in a DB BLOB column, not files -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <!-- version managed by the Spring Boot parent -->
    </dependency>

    <!-- MySQL driver (works against XAMPP's MariaDB 10.4 server too) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
