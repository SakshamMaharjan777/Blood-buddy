# --- Test harness output ---------------------------------------------------
# These are regenerated by every run of resptest/qa-harness.html,
# resptest/responsive-check.html and resptest/real-mode-check.html.
# The tools themselves (and the screenshots they produce as evidence) ARE
# tracked; only the raw dumps/logs below are not.
resptest/dom.txt
resptest/*-dom.txt
resptest/*-stderr.txt
resptest/_qa.txt
resptest/_real.txt
resptest/err.txt
resptest/canary-stderr.txt
resptest/*.log
resptest/report.html
resptest/console-test.html

# --- Local/dev noise -------------------------------------------------------
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# --- Backend build artifacts -------------------------------------------------
# static/ is GENERATED from the frontend by tools/sync_frontend_to_backend.py
# (source of truth: CODE/, CSS/, images/, resptest/, root 404.html) — do not edit
# or commit it.
backend/src/main/resources/static/
backend/target/
backend/.idea/
backend/*.iml

# --- Local dev tooling (portable, NOT part of the submission) ----------------
# .tools/ holds the Mailpit mail catcher (§2.4 dev inbox) + its captured mail.
.tools/

# tools/walkthrough is tracked, but its dependency folder and its screenshots are not
# (the output goes to .tools/wt/walkthrough/ by default — see BB_WALK_OUT).
tools/walkthrough/node_modules/

# --- Reference project (read-only, NOT part of BloodBuddy) -------------------
# Copied in for pattern reference only; must never be committed or submitted.
reference/
